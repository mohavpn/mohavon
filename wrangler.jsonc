{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mohavon",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "68eada3b-df58-4773-b02d-011962cfb4d1","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "c2d7bc08656243eca82f2630244ce025" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
